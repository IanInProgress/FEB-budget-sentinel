# Environment variables for the purchase bot
# Copy this file to .env (or set the variables in your shell) before running.

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Google Sheets configuration
GOOGLE_SHEET_ID=your-spreadsheet-id
# either the path to a service account JSON or the JSON itself
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
MANAGER_CHANNEL_ID=C123ABC456
# Purchase intake now uses slash commands:
# /purchase and /bigorder
ITEM_BUDGET_REJECT_THRESHOLD_PERCENT=125
ENABLE_MANAGER_DECISION_SCANNER=true
MANAGER_DECISION_SCAN_INTERVAL_SECONDS=30
# Optional settings
# LOG_LEVEL=INFO
# SLACK_COMMANDS_PATH=/slack/commands
# PORT=3000
